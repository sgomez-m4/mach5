	column Tipo
		dataType: string
		lineageTag: 323a02fd-b88e-4de6-b50a-30273f91f6a4
		summarizeBy: none
		sourceColumn: Tipo

		annotation SummarizationSetBy = Automatic

	column ID
		dataType: string
		isHidden
		lineageTag: 72d9ced2-0dd8-418e-b3a9-567ca31af7d2
		summarizeBy: none
		sourceColumn: ID

