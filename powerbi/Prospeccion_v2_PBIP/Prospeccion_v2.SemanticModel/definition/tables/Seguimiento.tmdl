	column clave_taller
		dataType: string
		isHidden
		lineageTag: a47c2f14-5ddc-4a6b-afdd-2e8c26198650
		summarizeBy: none
		sourceColumn: clave_taller

		annotation SummarizationSetBy = Automatic

	/// Cerrada (Ganado o Perdido), Sin contactar (sin accion), Sin fecha, Vencida o Al dia.
	column Situación =
			SWITCH (
			    TRUE (),
			    Seguimiento[Estado] IN { "Ganado", "Perdido" }, "Cerrada",
			    Seguimiento[Estado] = "Sin contactar" && ISBLANK ( Seguimiento[Próxima acción] ), "Sin contactar",
			    ISBLANK ( Seguimiento[Fecha próxima acción] ), "Sin fecha",
			    Seguimiento[Fecha próxima acción] < TODAY (), "Vencida",
			    "Al día"
			)
		dataType: string
		lineageTag: 0e8653bf-ff07-41e5-a7a3-6cf34334ed17
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition Seguimiento = m
		mode: import
		source =
				let
				    Contenido = if Text.StartsWith(RutaSeguimiento, "http") then Web.Contents(RutaSeguimiento) else File.Contents(RutaSeguimiento),
				    Libro = Excel.Workbook(Contenido, null, true),
				    Tabla = Libro{[Item="tblSeguimiento",Kind="Table"]}[Data],
				    Tipos = Table.TransformColumnTypes(Tabla, {{"Tipo", type text}, {"ID", type text}, {"Cuenta", type text}, {"Detalle", type text}, {"Estado", type text}, {"Responsable", type text}, {"Próxima acción", type text}, {"Fecha próxima acción", type date}, {"Último contacto", type date}, {"Notas", type text}}),
				    ConGrupo = Table.AddColumn(Tipos, "group_id", each if [Tipo] = "Aerolínea" and [ID] <> "" then [ID] else null, type text),
				    ConTaller = Table.AddColumn(ConGrupo, "clave_taller", each if [Tipo] = "Taller" and [ID] <> "" then [ID] else null, type text)
				in
				    ConTaller

	annotation PBI_ResultType = Table

